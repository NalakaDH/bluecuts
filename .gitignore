# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production / packaging
frontend/build/
release/
dist/

# Secrets & environment (do not commit)
.env
.env.*
!.env.example

# Runtime data — never commit customer DB or uploads
backend/data/
backend/uploads/
*.db
*.db-shm
*.db-wal

# Electron icon folder: ignore everything except committed icon
build/*
!build/icon.png

# Logs & OS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Testing
coverage/
.nyc_output/

# Misc
*.local
backend/data/_restore_tmp/
