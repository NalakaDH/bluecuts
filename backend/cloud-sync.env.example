# Copy to ONE of these locations on the shop PC (then restart Blue Cuts):
#
#   A) Next to the installed backend (development):
#      backend\.env
#
#   B) Per-user settings (recommended for installed app — survives updates):
#      %AppData%\Blue Cuts\cloud-sync.env
#      (same folder as the app database; create the file if missing)
#
# Also copy your Firebase service account JSON to:
#   %AppData%\Blue Cuts\firebase-service-account.json
# (Firebase Console → Project settings → Service accounts → Generate new private key)

BLUECUTS_SHOP_ID=bluecuts
BLUECUTS_CLOUD_SYNC_SECRET=your-long-random-secret

# Point to the JSON key file on THIS computer (use a real path, not the developer's PC):
FIREBASE_SERVICE_ACCOUNT_PATH=%APPDATA%\Blue Cuts\firebase-service-account.json
